# Supabase Postgres connection string (Transaction or Direct URL)
DATABASE_URL=DATABASE_URL='postgresql://postgres:<password>@<host>:5432/postgres'


# Optional Slack/Discord webhook for alerts
# AH_ALERT_WEBHOOK_URL=https://...

# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# LLM Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional OpenAI Integration (Fallback/Alternate)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# LLM Provider Choice: 'gemini' or 'openai'
# LLM_PROVIDER=gemini
